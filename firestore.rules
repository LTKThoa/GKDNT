rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'gYLZkMF72EfecKtwQ0CGlj2Pvef2';
    }

    function hasValidProductFields(data) {
      return data.keys().hasAll(['name', 'price', 'soluong', 'image'])
        && data.keys().hasOnly(['name', 'price', 'soluong', 'image'])
        && data.name is string
        && data.name.size() > 0
        && data.price is number
        && data.price >= 0
        && data.soluong is int
        && data.soluong >= 0
        && data.image is string
        && data.image.matches('https://res\\.cloudinary\\.com/.*');
    }

    match /products/{productId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && hasValidProductFields(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
